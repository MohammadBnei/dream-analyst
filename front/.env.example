# Every variable the server reads. Validated lazily by src/lib/server/env.ts,
# which fails naming each offending variable rather than booting misconfigured.

# --- Required ---

# Postgres. Previously interpolated as `${DATABASE_URL}`, which produced the
# literal string "undefined" when unset and handed that to the driver.
DATABASE_URL="postgres://user:password@host:5432/dreamer?sslmode=disable"

# Signs session cookies. REQUIRED — the app refuses to sign or verify a token
# without it, because a predictable signing key means anyone can forge a session
# for any user. Generate one with:  openssl rand -base64 48
JWT_SECRET=""

# Stream state and pub/sub for in-progress dream analysis.
REDIS_URL="redis://localhost:6379"

# LLM access. All model traffic goes through OpenRouter's OpenAI-compatible API.
OPENROUTER_API_KEY=""

# --- Optional (defaults shown) ---

# An unconfigured deployment silently runs Mistral-7B.
OPENROUTER_MODEL_NAME="mistralai/mistral-7b-instruct-v0.2"
OPENROUTER_WEAK_MODEL="meta-llama/llama-3.1-70b-instruct"

# Public origin, used for OpenRouter attribution headers.
ORIGIN=""

# Speech-to-text (ukubi-stt). STT_TOKEN_DREAMER is duplicated in ukubi-stt's own
# Infisical project — rotating it means editing BOTH, or dictation fails with
# UNAUTHENTICATED (surfacing as a 503 from /api/transcribe).
STT_ADDR="http://ukubi-stt.ukubi-stt.svc.cluster.local:9090"
STT_TOKEN_DREAMER=""

# Credit costs and per-role daily limits. Must be whole non-negative numbers; a
# malformed value is now rejected at startup instead of becoming NaN (which made
# every limit comparison false, disabling the check).
CREDIT_COST_DREAM_ANALYSIS="2"
CREDIT_COST_CHAT_MESSAGE="1"
DAILY_LIMIT_BASIC="10"
DAILY_LIMIT_VIP="50"
DAILY_LIMIT_ADMIN="999999"

# --- Public (exposed to the browser) ---
PUBLIC_ORIGIN=""
