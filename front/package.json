{
	"name": "dream-analyster",
	"private": true,
	"version": "0.32.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"postinstall": "test ! -f prisma/schema.prisma || prisma generate",
		"check": "bun run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun run generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prisma": "prisma",
		"reextract": "bun --preload ./scripts/env-preload.ts scripts/reextract.ts",
		"build:reextract": "bun build scripts/reextract.ts --target=bun --external '$env/dynamic/private' --outfile build/reextract.js",
		"reextract:deployed": "bun --preload ./scripts/env-preload.ts ./build/reextract.js",
		"machine-translate": "inlang machine translate --project project.inlang",
		"release": "release-it",
		"start": "bun run scripts/migrate-deploy.ts && bun ./build/index.js",
		"test:unit": "bun test src/",
		"e2e": "playwright test",
		"generate": "prisma generate && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"test:integration": "bun test tests/integration/"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/cli": "^3.2.0",
		"@inlang/paraglide-js": "2.23.0",
		"@playwright/test": "^1.62.0",
		"@release-it/conventional-changelog": "^12.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bcrypt": "^6.0.0",
		"@types/bun": "^1.3.14",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.10.1",
		"daisyui": "^5.7.4",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^16.4.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"release-it": "^21.0.0",
		"svelte": "^5.56.8",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0",
		"vite": "^8.1.5"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@sveltejs/kit": "^2.70.2",
		"bcrypt": "^6.0.0",
		"dotenv": "^17.4.2",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"openai": "^6.49.0",
		"prisma": "^7.9.1",
		"svelte-streamdown": "^3.1.2",
		"valibot": "^1.4.2"
	},
	"release-it": {
		"$schema": "https://unpkg.com/release-it@19/schema/release-it.json",
		"git": {
			"commitMessage": "chore: release v${version}"
		},
		"github": {
			"release": false
		},
		"npm": {
			"publish": false
		},
		"plugins": {
			"@release-it/conventional-changelog": {
				"preset": {
					"name": "angular"
				},
				"infile": "CHANGELOG.md"
			}
		}
	},
	"overrides": {
		"cookie": "^0.7.0",
		"deepmerge-ts": "^8.0.0",
		"dompurify": "^3.4.13",
		"fast-uri": "^3.1.6",
		"lodash": "^4.18.0",
		"lodash-es": "^4.18.0",
		"mdast-util-to-hast": "^13.2.1",
		"mermaid": "^11.16.1",
		"mysql2": "^3.22.0",
		"nanoid": "^3.3.18",
		"ws": "^8.21.0"
	}
}
